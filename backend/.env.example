# PromptChain API Keys
# Rename this file to .env and fill in your keys.
# Both providers below are free-tier, no card required.
# Groq:       https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/keys

GROQ_API_KEY="your-groq-api-key-here"
OPENROUTER_API_KEY="your-openrouter-api-key-here"

DATABASE_URL=sqlite:///./data/promptchain.db
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost/promptchain"
